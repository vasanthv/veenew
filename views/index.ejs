<!doctype html>
<html lang="en">
<%- include('partials/html-head', {title: "", stylesheet: "/landing.css"}); -%>

<body>
  <div id="app" class="wrap">
    <header>
      <%- include('partials/nav'); -%>
      <div class="spacer"></div>
      <h1 class="page-title"><em>Veenew</em> - <span style="font-weight: normal;">Build your corner of the web</span></h1>
    </header>

    <section>
      <p class="landing-lead">One calm space for everything you put on the web. Make a personal website, a blog, a status log or a bookmark collection, or mix them all on your own.</p>
      <p>Veenew is a simple blogging platform at its core, but flexible enough for regular blogs, microblogs, bookmarks, essays, journals, personal websites, and everything in between. </p>
      <div class="landing-cta">
        <a class="btn" href="/signup">Get started &rarr;</a>
        <a href="/login">Log in</a>
      </div>
    </section>

    <section class="showcase">
      <h2 class="landing-heading">Features</h2>
      <p class="customize-lead">Everything you need to write, share and grow your own corner of the web.</p>
      <div class="feature-rows">
        <div class="feature-row">
          <span>Unlimited Pages</span>
          <span>Unlimited Posts</span>
          <span>Photo uploads</span>
        </div>
        <div class="feature-row">
          <span>Markdown</span>
          <span>Microblogging</span>
          <span>Bookmarking</span>
        </div>
        <div class="feature-row">
          <span>Guestbook</span>
          <span>Email subscriptions</span>
          <span>RSS subscription</span>
        </div>
      </div>
      <div class="shot">
        <img src="/screenshots/author-home.png" alt="The Veenew author dashboard showing a list of pages" loading="lazy">
      </div>
      <div class="landing-cta landing-cta-center">
        <a class="btn" href="/signup">Get started &rarr;</a>
      </div>
    </section>

    <section class="showcase customize">
      <h2 class="landing-heading landing-heading-sm">Make it yours</h2>
      <p class="customize-lead">Pick from ready-made themes, add your own CSS, or even drop in custom javascripts.</p>
      <div class="customize-points">
        <span>Themes</span>
        <span>Custom styling</span>
        <span>Custom scripts</span>
      </div>
      <div class="fan">
        <img class="fan-card fan-left" src="/screenshots/profile-view-about-hack.png" alt="A Veenew site using the Hack theme" loading="lazy">
        <img class="fan-card fan-right" src="/screenshots/profile-view-about-rainbow.png" alt="A Veenew site using the Peach theme" loading="lazy">
        <img class="fan-card fan-center" src="/screenshots/profile-view-about-peach.png" alt="A Veenew site using the default theme" loading="lazy">
      </div>
    </section>

    <section class="pricing">
      <h2 class="landing-heading landing-heading-sm">Pricing</h2>
      <div class="plans">
        <div class="plan">
          <p class="plan-label">Everything</p>
          <p class="plan-price">Free</p>
          <p class="plan-note">for everyone, forever</p>
        </div>
        <div class="plan plan-addon">
          <p class="plan-label">Custom domain</p>
          <p class="plan-price">$36</p>
          <p class="plan-note">one-time fee, no subscription</p>
        </div>
      </div>
      <p class="pricing-support">Like Veenew? Support it on <a href="https://github.com/sponsors/vasanthv" target="_blank" rel="noopener noreferrer">GitHub Sponsors</a> or <a href="https://ko-fi.com/vasanthv" target="_blank" rel="noopener noreferrer">Ko-fi</a>.</p>
    </section>

    <section class="maker">
      <p class="maker-label">From the maker</p>
      <p class="maker-text">I built Veenew to be a calm place for my own writing, and I run my blog on it too. Take a look at a real site made with Veenew.</p>
      <a class="maker-link" href="https://vasanth.veenew.com" target="_blank" rel="noopener noreferrer">vasanth.veenew.com</a>
    </section>

    <%- include('partials/footer'); -%>
  </div>
</body>

</html>
