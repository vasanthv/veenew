<!doctype html>

<html lang="en">
<%- include('partials/html-head', {title: "Settings"}); -%>

<body>
  <div id="app" class="wrap">
    <%- include('partials/header',{title: "Settings"}); -%>

    <section>

      <details open>
        <summary>Profile</summary>
        <div class="field">
          <label for="name">Name</label>
          <input type="text" id="name" placeholder="Enter your name" v-model="myAccount.name" />
        </div>
        <div class="field">
          <label for="description">Description</label>
          <textarea id="description" placeholder="Enter a short description" v-model="myAccount.description" rows="2" maxlength="300"></textarea>
          <div class="help">Used in search and social previews and in your feed. It isn't shown on your blog.</div>
        </div>
        <div class="field">
          <label for="icon">Favicon</label>
          <% var faviconSrc = user.favicon && user.favicon.updatedOn ? "/favicon.png?v=" + new Date(user.favicon.updatedOn).getTime() : user.iconUrl; %>
          <div class="flex">
            <% if (faviconSrc) { %>
            <img src="<%= user.favicon && user.favicon.updatedOn ? userBaseUrl + faviconSrc.slice(1) : faviconSrc %>" alt="Current favicon" width="32" height="32" />
            <% } %>
            <input type="file" id="icon" class="flex-1" accept="image/png" v-on:change="uploadFavicon" :disabled="isLoading" />
            <% if (faviconSrc) { %>
            <button type="button" class="ghost" v-on:click="deleteFavicon" :disabled="isLoading">Remove</button>
            <% } %>
          </div>
          <div class="help">PNG only, up to 512KB. A square image works best. It is served from <code><%= userBaseUrl %>favicon.png</code>.</div>
        </div>
      </details>

      <details>
        <summary>Account</summary>
        <div class="field">
          <label for="username">Username</label>
          <input type="text" id="username" placeholder="Enter your username" v-model="myAccount.username" />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input type="text" id="email" placeholder="Enter your email" v-model="myAccount.email" />
          <% if(typeof user.emailVerificationCode !== "undefined") { %>
          <a href="javascript:void(0)" v-on:click="resendVerification">Resend verification</a>
          <% } %>
        </div>
        <div class="field">
          <label for="password">Password</label>
          <input type="password" id="password" placeholder="New password" v-model="myAccount.password" />
        </div>
      </details>


      <details>
        <summary>Custom domain</summary>
        <p>Serve your blog from your own domain instead of <code><%=user.username%>.<%= domain %></code>.</p>
        <div class="field">
          <label for="domain">Domain</label>
          <input type="text" id="domain" placeholder="Eg: blog.example.com" v-model="myAccount.domain" />
        </div>
        <p>
          Add a <code>CNAME</code> record at your domain registrar or DNS provider, then save here:
        </p>
        <p>
          Type: <code>CNAME</code><br />
          Name: your domain (some providers want only the first part, like <code>blog</code>)<br />
          Target: <code><%= cnameTarget %></code>
        </p>
        <div class="help">
          HTTPS is set up automatically the first time your domain is opened, which can take a few seconds. DNS changes can
          take up to a few hours. If your DNS is on Cloudflare, set the record to "DNS only". A root domain such as
          <code>example.com</code> can't have a CNAME at most providers, so use a subdomain like <code>www</code> or
          <code>blog</code>.
        </div>
      </details>

      <div class="spacer"></div>
      <div class="spacer"></div>

      <button v-on:click="updateAccount">Update</button>
    </section>

    <div class="spacer"></div>
    <div class="spacer"></div>
    <div class="spacer"></div>

    <section>
      <details>
        <summary>Account deletion</summary>
        <p>To delete your account, first delete all your posts, pages, notes, images, comments and subscribers, and remove your favicon. Your account is then permanently removed after 7 days. If you change your mind, just log back in within those 7 days to cancel the deletion.</p>

        <p><a href="/export" target="_blank">Export your data</a> before deleting it. The export has your posts, pages, notes, comments, subscribers and a list of your images with a link to each one. Image files are not in the export, so save them from those links.</p>

        <div v-if="!deleteConfirm">
          <button class="red" v-on:click="deleteConfirm = true">Delete account</button>
        </div>

        <div v-if="deleteConfirm">
          <p><strong>Are you sure?</strong></p>
          <button class="red" v-on:click="deleteAccount">Confirm & delete</button>
        </div>
      </details>
      <hr />
    </section>
    <div class="spacer"></div>
    <%- include('partials/footer'); -%>

  </div>

  <script type="text/javascript">
    window.onload = () => {
      App.myAccount = {
        username: <%- toScriptJson(user.username) %>,
        email: <%- toScriptJson(user.email) %>,
        name: <%- toScriptJson(user.name || "") %>,
        description: <%- toScriptJson(user.description || "") %>,
        password: "",
        domain: <%- toScriptJson(user.domain || "") %>,
      };
    }
  </script>
</body>

</html>