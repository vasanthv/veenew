<!doctype html>
<html lang="en">
<%- include('partials/html-head', {title: `${profile.name ?? profile.username} / ${title}`}); -%>

<body>
  <div id="app" class="wrap">
    <%- include('profile/header', {title: profile.name ?? profile.username}); -%>

    <section>
      <p>Stop getting emails about new posts from <%= profile.name ?? profile.username %>?</p>
      <form method="post" action="">
        <button type="submit">Unsubscribe</button>
      </form>
    </section>
    <%- include('profile/footer'); -%>
  </div>
</body>

</html>
