<!doctype html>
<html lang="en">
<% const isEdit = typeof bookmark !== "undefined"; %>
<%- include('partials/html-head', {title: `${isEdit ? "Edit" : "New"} bookmark`}); -%>

<body>
  <div id="app" class="wrap">
    <%- include('partials/header', {title: `${isEdit ? "Edit" : "New"} bookmark`}); -%>

    <section id="postbox">
      <form @submit.prevent="saveBookmark(<%- isEdit ? `'${bookmark._id}'` : "" %>)">
        <input type="url" v-model="bookmark.url" placeholder="link, eg: https://example.com" maxlength="2000" required />
        <div class="spacer"></div>
        <input type="text" v-model="bookmark.title" placeholder="title (optional, fetched from the link if empty)" maxlength="160" />
        <div class="spacer"></div>
        <textarea v-model="bookmark.notes" placeholder="notes (plain text, use #hashtags to tag)" maxlength="640"></textarea>
        <div class="spacer"></div>
        <label><input type="checkbox" v-model="bookmark.isPrivate" /> Private</label>
        <div class="spacer"></div>
        <div class="flex">
          <div class="flex-1">
            <% if (isEdit) { %>
            <a href="javascript:void(0)" v-on:click="deleteBookmark('<%= bookmark._id %>')" class="red">Delete bookmark</a>
            <% } %>
          </div>
          <button type="submit" :disabled="isLoading"><%= isEdit ? "Update" : "Add" %></button>
        </div>
        <div class="spacer"></div>
        <em>Title and notes are plain text. Markdown and HTML are not supported.</em>
      </form>
    </section>
    <%- include('partials/footer'); -%>
  </div>
  <% if (isEdit) { %>
  <script type="text/javascript">
    window.onload = () => {
      App.bookmark = <%- JSON.stringify({ url: bookmark.url, title: bookmark.title || "", notes: bookmark.notes || "", isPrivate: bookmark.isPrivate }).replace(/</g, "\\u003c") %>;
    };
  </script>
  <% } %>
</body>

</html>
