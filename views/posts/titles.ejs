<% if(typeof tags !== "undefined") { %>
<% if(tags.length > 0) { %>
<section>
  <h3>Tagged: <%=tags.join(",")%></h3>
</section>
<% } %>
<% } %>
<section>
  <% if(posts.length <= 0) { %>
  <div class="empty">No posts to show.</div>
  <% } else { %>
  <ul class="plain-list">
    <% for (var i = 0; i < posts.length; i++) { %>
    <% var label = posts[i].title || (posts[i].text || "").replace(/\s+/g, " ").trim().slice(0, 80) || "Untitled"; %>
    <li id="post-<%= posts[i]._id %>"><time class="post-date" datetime="<%= getPostDate(posts[i]) %>"><%= getPostDate(posts[i]) %></time><a href="<%= typeof userBaseUrl !== "undefined" ? userBaseUrl : "" %>post/<%= posts[i].slug || posts[i]._id %>"><%= label %></a><% if(typeof showEdit !== "undefined") { %> <small>&middot; <a href="/edit/<%= posts[i]._id %>">Edit</a></small><% if(posts[i].subscribersNotified === false) { %> <small>&middot; Subscribers have not been emailed</small><% } %><% } %></li>
    <% } %>
  </ul>
  <% } %>
</section>
