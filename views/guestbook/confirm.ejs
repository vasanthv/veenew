<!doctype html>
<html lang="en">
<%- include('partials/html-head', {title: `${profile.name ?? profile.username} / ${title}`}); -%>

<body>
  <div id="app" class="wrap">
    <%- include('profile/header', {title: profile.name ?? profile.username}); -%>

    <section>
      <p>Confirm your guestbook entry. It will be sent to the author once you do.</p>
      <blockquote>
        <strong><%= entry.name %></strong>
        <div style="white-space: pre-wrap;"><%= entry.text %></div>
      </blockquote>
      <form method="post" action="">
        <button type="submit">Confirm my entry</button>
      </form>
    </section>
    <%- include('profile/footer'); -%>
  </div>
</body>

</html>
