NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/veenew-dev
SECRET=

# Optional
DISABLE_CSRF=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Cloudflare Turnstile CAPTCHA on signup (https://dash.cloudflare.com/?to=/:account/turnstile). Leave empty to disable.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Number of reverse proxies in front of the app (0 when it is exposed directly)
TRUST_PROXY=1
# Header holding the visitor's real IP, used for rate limits. On DigitalOcean App Platform: do-connecting-ip.
# Leave empty to use X-Forwarded-For with TRUST_PROXY.
CLIENT_IP_HEADER=
# Region used for both SES (email) and S3 (photos and favicons)
AWS_REGION=us-west-2
NO_REPLY_EMAIL=Veenew <noreply@email.veenew.com>
# S3 bucket for uploaded photos and favicons (uses the AWS keys above, keep the bucket private)
AWS_S3_BUCKET=
# Comma-separated list of admin usernames who can access the newsletter page
ADMIN_USERNAMES=
# Analytics script URL, only loaded in production
ANALYTICS_URL=
